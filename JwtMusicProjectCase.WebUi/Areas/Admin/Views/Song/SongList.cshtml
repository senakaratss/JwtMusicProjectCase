@model List<ResultSongDto>
@{
    ViewData["Title"] = "SongList";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex items-center mb-16" style="justify-content:space-between; flex-wrap:wrap; gap:12px;">
    <div>
        <h2 class="font-display" style="font-size:19px;">Song Management</h2>
        <p class="text-tertiary" style="font-size:12.5px; margin:2px 0 0;">Platformdaki tüm şarkıları görüntüle, ekle ve düzenle.</p>
    </div>
    <a href="/Admin/Song/CreateSong" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
        Add Song
    </a>
</div>

<div class="card" data-table-root>
    <div class="table-toolbar">
        <div class="field-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
            <input type="text" data-table-search placeholder="Şarkı veya sanatçı ara..." />
        </div>
        <div class="toolbar-filters">
            <select class="field-select" data-table-filter="genre">
                <option value="">Tüm Genre'lar</option>
                <option value="pop">Pop</option>
                <option value="rock">Rock</option>
                <option value="r&b">R&amp;B</option>
                <option value="chill">Chill</option>
                <option value="hip-hop">Hip-Hop</option>
            </select>
            <select class="field-select" data-table-filter="package">
                <option value="">Tüm Paketler</option>
                <option value="free">Free</option>
                <option value="standard">Standard</option>
                <option value="premium">Premium</option>
            </select>
        </div>
    </div>

    <div style="overflow-x:auto;">
        <table class="data-table">
            <thead>
                <tr>
                    <th data-sort-key="name">Song <span class="sort-arrow">↕</span></th>
                    <th data-sort-key="artist">Artist <span class="sort-arrow">↕</span></th>
                    <th>Genre</th>
                    <th>Package</th>
                    <th data-sort-key="release">Release Date <span class="sort-arrow">↕</span></th>
                    <th data-sort-key="listens">Listen Count <span class="sort-arrow">↕</span></th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr data-genre="@s.GenreName" data-package="@s.PackageName">
                        <td data-col="name">
                            <div class="cell-media">
                                <div class="thumb-fallback">
                                    @if (s.CoverImageUrl != null)
                                    {
                                        <img src="@s.CoverImageUrl" />
                                    }
                                    else
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
                                    }
                                </div>
                                <div class="primary">@s.SongName</div>
                            </div>
                        </td>
                        <td data-col="artist">@s.ArtistName</td>
                        <td><span class="badge badge-violet">@s.GenreName</span></td>
                        <td><span class="badge badge-neutral">@s.PackageName</span></td>
                        <td data-col="release" class="text-secondary">@s.ReleaseDate.ToString("dd MMM yyyy")</td>
                        <td data-col="listens" data-value="@s.ListenCount" class="text-mono">@s.ListenCount</td>
                        <td>
                            <div class="row-actions">
                                <a asp-controller="Song" asp-action="UpdateSong" asp-route-id="@s.SongId" class="btn btn-outline btn-icon btn-sm" title="Edit">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4Z" /></svg>
                                </a>
                                <button class="btn btn-danger btn-icon btn-sm" title="Delete"
                                        data-confirm-delete data-name="@s.SongName"
                                        data-modal-open="deleteSongModal" data-target-form="#deleteForm-@s.SongId">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6" /></svg>
                                </button>
                                <form id="deleteForm-@s.SongId" asp-controller="Song" asp-action="DeleteSong" asp-route-id="@s.SongId" method="post" style="display:none;"></form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        @{
            int currentPage = ViewBag.CurrentPage;
            int totalPages = ViewBag.TotalPages;
            int pageSize = ViewBag.PageSize;
            int totalCount = ViewBag.TotalCount;

            int start = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
            int end = Math.Min(currentPage * pageSize, totalCount);
        }
        <span class="text-tertiary" style="font-size:12.5px;"> @totalCount sonuçtan @start–@end arası gösteriliyor</span>
        <div class="pagination">

            @if (currentPage > 1)
            {
                <a class="page-btn" asp-controller="Song" asp-action="SongList" asp-route-page="@(currentPage - 1)">
                    ‹
                </a>
            }
            else
            {
                <button class="page-btn" disabled>‹</button>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                {
                    <a class="page-btn active" asp-controller="Song" asp-action="SongList" asp-route-page="@i">
                        @i
                    </a>
                }
                else
                {
                    <a class="page-btn" asp-controller="Song" asp-action="SongList" asp-route-page="@i">
                        @i
                    </a>
                }
            }

            @if (currentPage < totalPages)
            {
                <a class="page-btn" asp-controller="Song" asp-action="SongList" asp-route-page="@(currentPage + 1)">
                    ›
                </a>
            }
            else
            {
                <button class="page-btn" disabled>›</button>
            }
        </div>
    </div>
</div>

@* ---------------- Delete confirmation modal ---------------- *@
<div class="modal-backdrop" id="deleteSongModal">
    <div class="modal-panel">
        <div class="modal-header">
            <h3>Şarkıyı Sil</h3>
            <button class="modal-close" data-modal-close>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-body">
            <div class="confirm-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /></svg>
            </div>
            <p style="margin:0 0 4px; font-size:14px; font-weight:600;">"<span data-confirm-name>bu şarkıyı</span>" silinsin mi?</p>
            <p class="text-tertiary" style="font-size:12.5px; margin:0;">Bu işlem geri alınamaz. Şarkı ve ilişkili tüm veriler kalıcı olarak silinecektir.</p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" data-modal-close>Vazgeç</button>
            <button class="btn btn-danger" data-confirm-submit>Sil</button>
        </div>
    </div>
</div>



@model CreateSongDto
@{
    ViewBag.Title = "Add Song";
    ViewBag.Breadcrumb = "Song Management";
    ViewBag.ActiveNav = "Songs";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}

<div class="mb-16">
    <a asp-controller="Song" asp-action="SongList" class="btn btn-ghost btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m12 19-7-7 7-7M19 12H5" /></svg>
        Songs
    </a>
    <h2 class="font-display" style="font-size:19px; margin-top:10px;">Add New Song</h2>
    <p class="text-tertiary" style="font-size:12.5px; margin:2px 0 0;">Şarkı bilgilerini, kapak görselini ve ses dosyasını yükleyin.</p>
</div>

<form asp-controller="Song" asp-action="CreateSong" method="post" enctype="multipart/form-data" class="card">
    <div class="card-body">
        <div class="form-grid">
            <div class="field">
                <label>Song Name <span class="req">*</span></label>
                <input class="input" type="text" asp-for="SongName" placeholder="Örn. Gece Yarısı" required />
                <span class="error-msg">Şarkı adı zorunludur.</span>
            </div>
            <div class="field">
                <label>Artist <span class="req">*</span></label>
                <select class="input" asp-items="@ViewBag.Artists" asp-for="ArtistId" required>
                    <option value="">Sanatçı seçin</option>
                </select>
            </div>

            <div class="field">
                <label>Genre <span class="req">*</span></label>
                <select class="input" asp-items="@ViewBag.Genres" asp-for="GenreId" required>
                    <option value="">Genre seçin</option>
                </select>
            </div>
            <div class="field">
                <label>Package <span class="req">*</span></label>
                <select class="input" asp-items="@ViewBag.Packages" asp-for="PackageId" required>
                    <option value="">Paket seçin</option>
                </select>
            </div>

            <div class="field">
                <label>Duration</label>
                <input class="input" type="text" asp-for="Duration" placeholder="Örn. 3:24" />
                <span class="hint">dk:sn formatında girin</span>
            </div>
            <div class="field">
                <label>Release Date</label>
                <input class="input" type="date" asp-for="ReleaseDate" />
            </div>
            <div class="field">
                <label>Listen Count</label>
                <input class="input" type="text" asp-for="ListenCount" placeholder="Örn. 324" />
                <span class="hint">Şarkı dinlendikçe otomatik artar.</span>
            </div>
            <div class="field">
                <label>Cover Image</label>
                <input class="input" type="url" asp-for="CoverImageUrl" placeholder="https://ornek.com/kapak.jpg" />
                <span class="hint">Kapak görseli için tam URL girin (JPG, PNG vb.)</span>
            </div>

            <div class="field">
                <label>Audio / MP3 File</label>
                <div class="upload-zone">
                    <input type="file" accept="audio/*" asp-for="AudioFile" />
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
                    <div class="upload-title">Ses dosyası yükle</div>
                    <div class="upload-hint">MP3, WAV · maks. 20MB</div>
                </div>
                <div class="upload-preview">
                    <div class="thumb-fallback" style="width:42px;height:42px;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
                    </div>
                    <div class="file-info">
                        <div class="file-name" data-file-name></div>
                        <div class="file-meta" data-file-meta></div>
                    </div>
                    <button type="button" class="remove-file">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                    </button>
                </div>
            </div>

            <div class="field full">
                <label>Lyrics</label>
                <textarea class="input" asp-for="Lyrics" rows="6" placeholder="Şarkı sözlerini buraya yapıştırın..."></textarea>
                <span class="hint">İsteğe bağlı. Satır sonlarını olduğu gibi koruyabilirsiniz.</span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-controller="Song" asp-action="SongList" class="btn btn-outline">İptal</a>
            <button type="submit" class="btn btn-primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8M7 3v5h8" /></svg>
                Add Song
            </button>
        </div>
    </div>
</form>



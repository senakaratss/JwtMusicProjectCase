@model GetByIdArtistDto
@{
    ViewData["Title"] = "UpdateArtist";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .form-back {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12.5px;
        color: var(--text-tertiary);
        text-decoration: none;
        margin-bottom: 12px;
        width: fit-content;
    }

        .form-back:hover {
            color: var(--text-primary);
        }

    .profile-hero {
        position: relative;
        margin-bottom: 56px;
        height: 150px;
    }

    .cover-wrap {
        width: 100%;
        height: 100%;
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: linear-gradient(135deg,var(--violet),var(--accent) 70%);
        border: 1px solid var(--border-subtle);
    }

        .cover-wrap img.cover-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .profile-avatar-wrap {
        position: absolute;
        left: 24px;
        bottom: -40px;
        width: 88px;
        height: 88px;
    }

    .profile-avatar {
        position: absolute;
        top: 0;
        left: 0;
        width: 88px;
        height: 88px;
        border-radius: 50%;
        border: 4px solid var(--bg-app);
        object-fit: cover;
        background: linear-gradient(135deg,var(--accent),var(--violet));
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent-ink);
        font-family: var(--font-display);
        font-size: 30px;
        font-weight: 700;
    }

    .form-columns {
        display: grid;
        grid-template-columns: 1fr 260px;
        gap: 20px;
        align-items: start;
    }

    @@media (max-width: 820px) {
        .form-columns {
            grid-template-columns: 1fr;
        }
    }

    .meta-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: 16px;
        font-size: 12px;
        color: var(--text-tertiary);
        line-height: 1.5;
    }

        .meta-card + .meta-card {
            margin-top: 0;
        }

    .meta-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        border-bottom: 1px dashed var(--border-subtle);
        font-size: 12.5px;
    }

        .meta-row:last-child {
            border-bottom: none;
        }

        .meta-row .meta-label {
            color: var(--text-tertiary);
        }

        .meta-row .meta-value {
            color: var(--text-primary);
            font-weight: 600;
        }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 600;
    }

        .status-pill.approved {
            background: rgba(34,197,94,0.12);
            color: #22c55e;
        }

        .status-pill.pending {
            background: rgba(234,179,8,0.12);
            color: #eab308;
        }

    .verified-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 6px 0;
    }

        .verified-row .verified-label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-primary);
        }

            .verified-row .verified-label svg {
                color: #3b82f6;
            }

    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 38px;
        height: 22px;
        flex: none;
    }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .toggle-switch .toggle-slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background: var(--border-subtle);
            border-radius: 999px;
            transition: background .15s ease;
        }

            .toggle-switch .toggle-slider::before {
                content: "";
                position: absolute;
                width: 16px;
                height: 16px;
                left: 3px;
                top: 3px;
                background: #fff;
                border-radius: 50%;
                transition: transform .15s ease;
            }

        .toggle-switch input:checked + .toggle-slider {
            background: #3b82f6;
        }

            .toggle-switch input:checked + .toggle-slider::before {
                transform: translateX(16px);
            }

    .field-with-icon {
        position: relative;
    }

        .field-with-icon svg {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-tertiary);
            pointer-events: none;
        }

        .field-with-icon input.input {
            padding-left: 36px;
        }
</style>

<a href="/Admin/Artist/ArtistList" class="form-back">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
    Sanatçılara dön
</a>

<form asp-controller="Artist" asp-area="Admin" asp-action="UpdateArtist" method="post">
    <input type="hidden" asp-for="ArtistId" />

    <div class="profile-hero">
        <div class="cover-wrap">
            <img class="cover-img" id="coverPreview" alt="Cover" src="@Model.CoverImageUrl" style="@(string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? "display:none;" : "")" onerror="this.style.display='none';" />
        </div>

        <div class="profile-avatar-wrap">
            <img class="profile-avatar" id="avatarPreview" src="@Model.ArtistImageUrl" style="@(string.IsNullOrWhiteSpace(Model.ArtistImageUrl) ? "display:none;" : "")" onerror="this.style.display='none'; document.getElementById('avatarFallback').style.display='flex';" />
            <div class="profile-avatar" id="avatarFallback" style="@(string.IsNullOrWhiteSpace(Model.ArtistImageUrl) ? "display:flex;" : "display:none;")">@(string.IsNullOrWhiteSpace(Model.ArtistName) ? "?" : Model.ArtistName.Substring(0, 1).ToUpper())</div>
        </div>
    </div>

    <div style="margin-bottom:20px;">
        <h2 class="font-display" style="font-size:19px; margin:0;">Edit Artist</h2>
        <p class="text-tertiary" style="font-size:12.5px; margin:2px 0 0;">Sanatçı bilgilerini güncelle ve kaydet.</p>
    </div>

    <div class="form-columns">
        <div class="card" style="padding:20px;">
            <div class="form-grid single">
                <div class="field">
                    <label>Artist Name <span class="req">*</span></label>
                    <input class="input" type="text" id="artistNameInput" asp-for="ArtistName" placeholder="Örn. Ada Yıldız" required />
                    <span class="error-msg">Sanatçı adı zorunludur.</span>
                </div>

                <div class="field">
                    <label>Artist Image URL</label>
                    <div class="field-with-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></svg>
                        <input class="input" type="url" id="artistImageUrlInput" asp-for="ArtistImageUrl" placeholder="https://.../sanatci-fotografi.jpg" />
                    </div>
                    <span class="hint">Kare (min. 400×400) bir görsel URL'si önerilir.</span>
                </div>

                <div class="field">
                    <label>Cover Image URL</label>
                    <div class="field-with-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></svg>
                        <input class="input" type="url" id="coverImageUrlInput" asp-for="CoverImageUrl" placeholder="https://.../kapak-fotografi.jpg" />
                    </div>
                    <span class="hint">Geniş bir görsel (yaklaşık 1200×400) önerilir.</span>
                </div>

                <div class="field">
                    <label>Country</label>
                    <input class="input" type="text" asp-for="Country" list="countryList" placeholder="Örn. Türkiye" />
                    <datalist id="countryList">
                        <option value="Türkiye" />
                        <option value="Almanya" />
                        <option value="Fransa" />
                        <option value="Amerika Birleşik Devletleri" />
                        <option value="Birleşik Krallık" />
                    </datalist>
                </div>

                <div class="field">
                    <label>Bio</label>
                    <textarea class="input" asp-for="Bio" placeholder="Sanatçı hakkında kısa bir tanıtım yazısı...">@Model.Bio</textarea>
                </div>
            </div>
        </div>

        <div style="display:flex; flex-direction:column; gap:14px;">
            <div class="meta-card">
                <div class="verified-row">
                    <span class="verified-label">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l2.6 2.4 3.5-.6.9 3.4 3.4.9-.6 3.5L24 12l-2.4 2.6.6 3.5-3.4.9-.9 3.4-3.5-.6L12 24l-2.6-2.4-3.5.6-.9-3.4-3.4-.9.6-3.5L0 12l2.4-2.6-.6-3.5 3.4-.9.9-3.4 3.5.6L12 1z" /><path d="M9.5 12.8l1.8 1.8 3.7-3.9" stroke="var(--bg-surface)" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        Doğrulanmış Sanatçı
                    </span>
                    <label class="toggle-switch">
                        <input type="checkbox" asp-for="IsVerified" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="meta-row" style="border-top:1px dashed var(--border-subtle); margin-top:4px; padding-top:10px;">
                    <span class="meta-label">Onay Durumu</span>
                    <span class="meta-value">
                        @if (Model.IsVerified)
                        {
                            <span class="status-pill approved">Onaylı</span>
                        }
                        else
                        {
                            <span class="status-pill pending">Onay Bekliyor</span>
                        }
                    </span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Oluşturulma Tarihi</span>
                    <span class="meta-value">@Model.CreatedDate.ToString("dd.MM.yyyy")</span>
                </div>
            </div>

            <div class="meta-card">
                Görseller dosya olarak yüklenmez; barındırdığınız bir CDN/depolama adresinin URL'sini yapıştırmanız yeterli. Değişiklikler kaydedildikten sonra hemen yansır.
            </div>
        </div>
    </div>

    <div class="modal-footer" style="border:none; padding:24px 0 0; justify-content:flex-end;">
        <a href="/Admin/Artist/ArtistList" class="btn btn-outline" style="text-decoration:none;">Vazgeç</a>
        <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
    </div>
</form>

@section Scripts {
    <script>
        function wirePreview(inputId, imgId, fallbackId) {
            var input = document.getElementById(inputId);
            var img = document.getElementById(imgId);
            if (!input || !img) return;
            input.addEventListener('input', function () {
                var url = input.value.trim();
                if (!url) {
                    img.style.display = 'none';
                    img.removeAttribute('src');
                    if (fallbackId) document.getElementById(fallbackId).style.display = 'flex';
                    return;
                }
                if (fallbackId) document.getElementById(fallbackId).style.display = 'none';
                img.src = url;
                img.style.display = 'block';
            });
        }
        wirePreview('coverImageUrlInput', 'coverPreview', null);
        wirePreview('artistImageUrlInput', 'avatarPreview', 'avatarFallback');

        // keep the fallback initial in sync with the typed artist name
        var nameInput = document.getElementById('artistNameInput');
        var fallback = document.getElementById('avatarFallback');
        if (nameInput && fallback) {
            nameInput.addEventListener('input', function () {
                var v = nameInput.value.trim();
                fallback.textContent = v ? v.charAt(0).toUpperCase() : '?';
            });
        }
    </script>
}

@model GenreDetailViewModel
@{
    ViewData["Title"] = "SongListByGenre";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
@{
    var accents = new[] { "#ffb627", "#7b2ff7", "#5fd0c0", "#ff6b57", "#5b8cff", "#ff5fa2" };
    var accent = accents[new Random().Next(accents.Length)];
    int i = 0;
}
<style>
    .genre-detail-page {
        --accent: @accent;
        --ink: #f5f3ee;
        --ink-dim: #9793a3;
        --line: #ffffff14;
        color: var(--ink);
        font-family: 'Inter', sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    .genre-detail-page a {
        color: inherit;
        text-decoration: none;
    }

    @@media (prefers-reduced-motion: reduce) {
        .genre-detail-page * {
            animation-duration: .001ms !important;
            transition-duration: .001ms !important;
        }
    }

    .genre-detail-page .breadcrumb {
        max-width: 1180px;
        margin: 26px auto 0;
        padding: 0 clamp(20px,5vw,56px);
        font-family: 'JetBrains Mono', monospace;
        font-size: .75rem;
        color: var(--ink-dim);
        letter-spacing: .06em;
    }

    .genre-detail-page .breadcrumb a:hover {
        color: var(--accent);
    }

    .genre-detail-page .genre-hero {
        max-width: 1180px;
        margin: 0 auto;
        padding: 34px clamp(20px,5vw,56px) 44px;
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 44px;
        align-items: end;
    }

    @@media (max-width:720px) {
        .genre-detail-page .genre-hero {
            grid-template-columns: 1fr;
            text-align: center;
            justify-items: center;
        }
    }

    .genre-detail-page .vinyl-wrap {
        position: relative;
        width: 220px;
        height: 220px;
    }

    .genre-detail-page .vinyl {
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: repeating-radial-gradient(circle at 50% 50%, #00000060 0 2px, transparent 2px 6px),
                    conic-gradient(from 0deg, var(--accent), #05050a 40%, var(--accent) 60%, #05050a);
        box-shadow: 0 30px 60px -20px #000000aa;
        animation: genre-spin 9s linear infinite;
        position: relative;
    }

    @@keyframes genre-spin {
        to { transform: rotate(360deg); }
    }

    .genre-detail-page .vinyl::after {
        content: "";
        position: absolute;
        inset: 38%;
        border-radius: 50%;
        background: radial-gradient(circle, var(--accent) 0%, #1a1300 70%);
        border: 2px solid #00000066;
    }

    .genre-detail-page .vinyl::before {
        content: "";
        position: absolute;
        inset: 47%;
        border-radius: 50%;
        background: #0b0b12;
        z-index: 2;
    }

    .genre-detail-page .hero-meta .eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: .72rem;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .genre-detail-page .hero-meta .eyebrow::before {
        content: "";
        width: 26px;
        height: 1px;
        background: var(--accent);
    }

    .genre-detail-page .hero-meta h1 {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: clamp(2.4rem,6vw,4.4rem);
        line-height: 1;
        letter-spacing: -.02em;
        margin: 0 0 14px;
        color: var(--ink);
    }

    .genre-detail-page .hero-meta p {
        color: var(--ink-dim);
        max-width: 52ch;
        line-height: 1.6;
        margin: 0 0 26px;
    }

    .genre-detail-page .hero-actions {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .genre-detail-page .play-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--accent);
        color: #1a1300;
        border: 0;
        padding: 14px 26px;
        border-radius: 999px;
        font-weight: 700;
        font-size: .95rem;
        cursor: pointer;
        transition: transform .2s;
    }

    .genre-detail-page .play-btn:hover {
        transform: scale(1.04);
    }

    .genre-detail-page .play-btn:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 3px;
    }

    .genre-detail-page .icon-btn {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--ink);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .genre-detail-page .icon-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

    .genre-detail-page .stat {
        font-family: 'JetBrains Mono', monospace;
        font-size: .8rem;
        color: var(--ink-dim);
    }

    .genre-detail-page .tracklist {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 clamp(20px,5vw,56px) 110px;
    }

    .genre-detail-page .tl-head {
        display: grid;
        grid-template-columns: 36px 1fr 160px 90px;
        gap: 16px;
        padding: 0 18px 12px;
        border-bottom: 1px solid var(--line);
        font-family: 'JetBrains Mono', monospace;
        font-size: .7rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-dim);
    }

    .genre-detail-page .tl-head span:last-child {
        text-align: right;
    }

    @@media (max-width:640px) {
        .genre-detail-page .tl-head span:nth-child(3) { display: none; }
        .genre-detail-page .tl-head { grid-template-columns: 30px 1fr 70px; }
    }

    .genre-detail-page .track {
        display: grid;
        grid-template-columns: 36px 1fr 160px 90px;
        gap: 16px;
        align-items: center;
        padding: 13px 18px;
        border-radius: 12px;
        transition: background .2s;
    }

    @@media (max-width:640px) {
        .genre-detail-page .track { grid-template-columns: 30px 1fr 70px; }
        .genre-detail-page .track .album-col { display: none; }
    }

    .genre-detail-page .track:hover,
    .genre-detail-page .track:focus-visible {
        background: #ffffff0a;
        outline: none;
    }

    .genre-detail-page .track:focus-visible {
        box-shadow: inset 0 0 0 1px var(--accent);
    }

    .genre-detail-page .track .idx {
        font-family: 'JetBrains Mono', monospace;
        color: var(--ink-dim);
        font-size: .85rem;
    }

    .genre-detail-page .track:hover .idx {
        color: var(--accent);
    }

    .genre-detail-page .track-info {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .genre-detail-page .cover {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        flex: none;
        background: linear-gradient(135deg, var(--accent), #1a1300);
    }

    .genre-detail-page .track-info .txt {
        min-width: 0;
    }

    .genre-detail-page .track-info .title {
        font-weight: 600;
        font-size: .95rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .genre-detail-page .track-info .artist {
        color: var(--ink-dim);
        font-size: .82rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .genre-detail-page .album-col {
        color: var(--ink-dim);
        font-size: .84rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .genre-detail-page .dur {
        font-family: 'JetBrains Mono', monospace;
        color: var(--ink-dim);
        font-size: .82rem;
        text-align: right;
    }
</style>

<div class="genre-detail-page">

    <div class="breadcrumb">
    </div>

    <section class="genre-hero">
        <div class="vinyl-wrap"><div class="vinyl"></div></div>
        <div class="hero-meta">
            <div class="eyebrow">Tür</div>
            <h1>@Model.GenreName</h1>
            <div class="hero-actions">
                <a class="play-btn" href="#">▶ Tümünü çal</a>
                <button class="icon-btn" title="Beğen" aria-label="Beğen">♡</button>
                <button class="icon-btn" title="Paylaş" aria-label="Paylaş">⇪</button>
                <span class="stat">@Model.Songs.Count parça</span>
            </div>
        </div>
    </section>

    <section class="tracklist">
        <div class="tl-head">
            <span>#</span><span>Parça</span><span class="album-col">Dinlenme Sayısı</span><span>Süre</span>
        </div>

        
        @foreach (var song in Model.Songs)
        {
            i++;
            <a class="track" href="/Song/SongDetail/@song.SongId">
                <span class="idx">@i.ToString("00")</span>
                <div class="track-info">
                    <span class="cover" aria-hidden="true"></span>
                    <div class="txt">
                        <div class="title">@song.SongName</div>
                        <div class="artist">@song.ArtistName</div>
                    </div>
                </div>
                <span class="album-col">@song.ListenCount</span>
                <span class="dur">@song.Duration</span>
            </a>
        }
    </section>
</div>


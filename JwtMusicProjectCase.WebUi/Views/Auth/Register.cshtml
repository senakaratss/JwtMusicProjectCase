@model RegisterDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en-US" dir="ltr">
<head>
    <meta charset="utf-8" />
    <title>Signup | Bepop - Music Web Application</title>
    <meta name="description" content="Responsive, Bootstrap, BS4" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #0a0a0f;
            --panel: #121218;
            --panel-2: #17171f;
            --line: #24242e;
            --text: #f5f5f7;
            --muted: #86869a;
            --accent-a: #ff3d68;
            --accent-b: #7b2ff7;
            --accent-c: #2de0c6;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            height: 100%;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', -apple-system, sans-serif;
        }

        .layout {
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            min-height: 100vh;
        }

        /* ---------- Left: identity panel ---------- */
        .stage {
            position: relative;
            overflow: hidden;
            background: linear-gradient(200deg, rgba(10,10,15,.35) 0%, rgba(10,10,15,.85) 55%, #0a0a0f 100%), url('/Bepop/assets/img/b7.jpg') center / cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3rem;
        }

        .brand-row {
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .brand-mark {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: conic-gradient(from 90deg, var(--accent-a), var(--accent-b), var(--accent-c), var(--accent-a));
            position: relative;
            flex: none;
        }

            .brand-mark::after {
                content: '';
                position: absolute;
                inset: 34%;
                background: var(--bg);
                border-radius: 50%;
            }

        .brand-name {
            font-family: 'Unbounded', sans-serif;
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: .02em;
        }

        .stage-copy {
            max-width: 420px;
            margin-top: auto;
            margin-bottom: 3.5rem;
        }

        .stage-eyebrow {
            font-size: .72rem;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--accent-c);
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .stage-headline {
            font-family: 'Unbounded', sans-serif;
            font-weight: 800;
            font-size: clamp(2.2rem, 4vw, 3.2rem);
            line-height: 1.05;
            margin: 0 0 1rem;
        }

            .stage-headline span {
                background: linear-gradient(95deg, var(--accent-a), var(--accent-b));
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

        .stage-sub {
            color: var(--muted);
            font-size: .95rem;
            line-height: 1.6;
        }

        /* equalizer signature */
        .eq {
            display: flex;
            align-items: flex-end;
            gap: 5px;
            height: 46px;
        }

            .eq span {
                width: 4px;
                border-radius: 3px;
                background: linear-gradient(180deg, var(--accent-c), var(--accent-b));
                animation: bounce 1.2s ease-in-out infinite;
                opacity: .85;
            }

                .eq span:nth-child(1) {
                    height: 30%;
                    animation-delay: -1.0s;
                }

                .eq span:nth-child(2) {
                    height: 65%;
                    animation-delay: -0.8s;
                }

                .eq span:nth-child(3) {
                    height: 45%;
                    animation-delay: -1.3s;
                }

                .eq span:nth-child(4) {
                    height: 90%;
                    animation-delay: -0.5s;
                }

                .eq span:nth-child(5) {
                    height: 55%;
                    animation-delay: -0.2s;
                }

                .eq span:nth-child(6) {
                    height: 75%;
                    animation-delay: -1.1s;
                }

                .eq span:nth-child(7) {
                    height: 35%;
                    animation-delay: -0.6s;
                }

                .eq span:nth-child(8) {
                    height: 60%;
                    animation-delay: -0.9s;
                }

                .eq span:nth-child(9) {
                    height: 40%;
                    animation-delay: -0.3s;
                }

                .eq span:nth-child(10) {
                    height: 80%;
                    animation-delay: -1.4s;
                }

                .eq span:nth-child(11) {
                    height: 50%;
                    animation-delay: -0.7s;
                }

                .eq span:nth-child(12) {
                    height: 25%;
                    animation-delay: -0.4s;
                }

        @@keyframes bounce {
            0%, 100%

        {
            transform: scaleY(.35);
        }

        50% {
            transform: scaleY(1);
        }

        }

        .stage-foot {
            display: flex;
            gap: 1.4rem;
            font-size: .82rem;
            color: var(--muted);
        }

            .stage-foot a {
                color: var(--muted);
                text-decoration: none;
            }

                .stage-foot a:hover {
                    color: var(--text);
                }

        /* ---------- Right: form panel ---------- */
        .panel {
            background: var(--panel);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 2rem;
        }

        .form-wrap {
            width: 100%;
            max-width: 380px;
        }

            .form-wrap h1 {
                font-family: 'Unbounded', sans-serif;
                font-size: 1.5rem;
                font-weight: 700;
                margin: 0 0 .3rem;
            }

            .form-wrap .lede {
                color: var(--muted);
                font-size: .88rem;
                margin: 0 0 1.6rem;
            }

        .socials {
            display: flex;
            gap: .6rem;
            margin-bottom: 1.4rem;
        }

        .social-btn {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--panel-2);
            border: 1px solid var(--line);
            color: var(--text);
            transition: border-color .18s ease, transform .18s ease;
        }

            .social-btn:hover {
                border-color: var(--accent-b);
                transform: translateY(-2px);
            }

            .social-btn svg {
                width: 15px;
                height: 15px;
            }

        .divider {
            display: flex;
            align-items: center;
            gap: .8rem;
            color: var(--muted);
            font-size: .72rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            margin: 1.4rem 0 1.3rem;
        }

            .divider::before, .divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--line);
            }

        .field {
            position: relative;
            margin-bottom: 1.05rem;
        }

            .field input {
                width: 100%;
                background: var(--panel-2);
                border: 1px solid var(--line);
                border-radius: 10px;
                padding: 1.15rem .9rem .45rem;
                font-size: .92rem;
                color: var(--text);
                font-family: 'Inter', sans-serif;
                outline: none;
                transition: border-color .18s ease, background .18s ease;
            }

                .field input::placeholder {
                    color: transparent;
                }

            .field label {
                position: absolute;
                left: .9rem;
                top: .95rem;
                font-size: .92rem;
                color: var(--muted);
                pointer-events: none;
                transition: all .15s ease;
            }

            .field input:focus,
            .field input:not(:placeholder-shown) {
                border-color: var(--accent-b);
            }

                .field input:focus + label,
                .field input:not(:placeholder-shown) + label {
                    top: .38rem;
                    font-size: .66rem;
                    letter-spacing: .03em;
                    color: var(--accent-c);
                }

        .row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .8rem;
        }

        .terms {
            font-size: .78rem;
            color: var(--muted);
            margin: .4rem 0 1.3rem;
            line-height: 1.5;
        }

            .terms a {
                color: var(--accent-c);
                text-decoration: none;
            }

                .terms a:hover {
                    text-decoration: underline;
                }

        .btn-submit {
            width: 100%;
            border: none;
            border-radius: 10px;
            padding: .95rem 1rem;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: .92rem;
            color: #0a0a0f;
            background: linear-gradient(95deg, var(--accent-c), var(--accent-a) 130%);
            cursor: pointer;
            transition: filter .18s ease, transform .18s ease;
        }

            .btn-submit:hover {
                filter: brightness(1.08);
                transform: translateY(-1px);
            }

        .signin-note {
            text-align: center;
            font-size: .85rem;
            color: var(--muted);
            margin-top: 1.4rem;
        }

            .signin-note a {
                color: var(--text);
                font-weight: 600;
                text-decoration: none;
                border-bottom: 1px solid var(--accent-b);
            }

        .validation-summary-errors ul {
            list-style: none;
            padding: .8rem 1rem;
            margin: 0 0 1.1rem;
            background: rgba(255, 61, 104, .1);
            border: 1px solid rgba(255, 61, 104, .35);
            border-radius: 10px;
            color: #ff8ba3;
            font-size: .82rem;
        }

        @@media (max-width: 860px) {
            .layout

        {
            grid-template-columns: 1fr;
        }

        .stage {
            display: none;
        }

        }
    </style>
</head>
<body>
    <div class="layout">
        <div class="stage">
            <div class="brand-row">
                <div class="brand-mark"></div>
                <div class="brand-name">Bepop</div>
            </div>

            <div class="stage-copy">
                <div class="stage-eyebrow">Music Web Application</div>
                <h1 class="stage-headline">Your next favorite <span>track</span> is one signup away.</h1>
                <p class="stage-sub">Join a community built around sound &mdash; curated playlists, live drops, and the artists you haven't discovered yet.</p>
            </div>

            <div class="eq" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span><span></span>
            </div>

            <div class="stage-foot" style="margin-top:1.4rem;">
                <a href="index.html">About</a>
                <a href="#">Terms</a>
                <a href="#">Policy</a>
            </div>
        </div>

        <div class="panel">
            <div class="form-wrap">
                <h1>Create your account</h1>
                <p class="lede">Sign up with your social network</p>

                <form method="post">
                    <div class="socials">
                        <a href="#" class="social-btn" aria-label="Sign up with Facebook">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 264 512">
                                <path fill="currentColor" d="M76.7 512V283H0v-91h76.7v-71.7C76.7 42.4 124.3 0 193.8 0c33.3 0 61.9 2.5 70.2 3.6V85h-48.2c-37.8 0-45.1 18-45.1 44.3V192H256l-11.7 91h-73.6v229" />
                            </svg>
                        </a>
                        <a href="#" class="social-btn" aria-label="Sign up with Twitter">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                                <path fill="currentColor" d="M459.37 151.716c.325 4.548.325 9.097.325 13.645 0 138.72-105.583 298.558-298.558 298.558-59.452 0-114.68-17.219-161.137-47.106 8.447.974 16.568 1.299 25.34 1.299 49.055 0 94.213-16.568 130.274-44.832-46.132-.975-84.792-31.188-98.112-72.772 6.498.974 12.995 1.624 19.818 1.624 9.421 0 18.843-1.3 27.614-3.573-48.081-9.747-84.143-51.98-84.143-102.985v-1.299c13.969 7.797 30.214 12.67 47.431 13.319-28.264-18.843-46.781-51.005-46.781-87.391 0-19.492 5.197-37.36 14.294-52.954 51.655 63.675 129.3 105.258 216.365 109.807-1.624-7.797-2.599-15.918-2.599-24.04 0-57.828 46.782-104.934 104.934-104.934 30.213 0 57.502 12.67 76.67 33.137 23.715-4.548 46.456-13.32 66.599-25.34-7.798 24.366-24.366 44.833-46.132 57.827 21.117-2.273 41.584-8.122 60.426-16.243-14.292 20.791-32.161 39.308-52.628 54.253z" />
                            </svg>
                        </a>
                        <a href="#" class="social-btn" aria-label="Sign up with Google">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512">
                                <path fill="currentColor" d="M488 261.8C488 403.3 391.1 504 248 504 110.8 504 0 393.2 0 256S110.8 8 248 8c66.8 0 123 24.5 166.3 64.9l-67.5 64.9C258.5 52.6 94.3 116.6 94.3 256c0 86.5 69.1 156.6 153.7 156.6 98.2 0 135-70.4 140.8-106.9H248v-85.3h236.1c2.3 12.7 3.9 24.9 3.9 41.4z" />
                            </svg>
                        </a>
                    </div>

                    <div class="divider">or with email</div>

                    <div asp-validation-summary="ModelOnly"></div>

                    <div class="row-2">
                        <div class="field">
                            <input type="text" asp-for="Name" placeholder=" " required>
                            <label>Name</label>
                        </div>
                        <div class="field">
                            <input type="text" asp-for="Surname" placeholder=" " required>
                            <label>Surname</label>
                        </div>
                    </div>

                    <div class="field">
                        <input type="text" asp-for="Username" placeholder=" " required>
                        <label>Username</label>
                    </div>

                    <div class="field">
                        <input type="email" asp-for="Email" placeholder=" " required>
                        <label>Email</label>
                    </div>

                    <div class="field">
                        <input type="text" asp-for="PhoneNumber" placeholder=" " required>
                        <label>Phone number</label>
                    </div>

                    <div class="field">
                        <input type="password" asp-for="Password" placeholder=" " required>
                        <label>Password</label>
                    </div>

                    <div class="field">
                        <input type="password" asp-for="ConfirmPassword" placeholder=" " required>
                        <label>Confirm password</label>
                    </div>

                    <p class="terms">By clicking Sign up, I agree to the <a href="#">Terms of service</a>.</p>

                    <button type="submit" class="btn-submit">Sign up</button>

                    <p class="signin-note">Already have an account? <a href="/Auth/Login/">Sign in</a></p>
                </form>
            </div>
        </div>
    </div>
</body>
</html>

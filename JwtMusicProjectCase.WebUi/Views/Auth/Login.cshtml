@model LoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en-US" dir="ltr">
<head>
    <meta charset="utf-8" />
    <title>Signin | Bepop - Music Web Application</title>
    <meta name="description" content="Responsive, Bootstrap, BS4" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #0a0a0f;
            --panel: #121218;
            --panel-2: #17171f;
            --line: #24242e;
            --text: #f5f5f7;
            --muted: #86869a;
            --accent-a: #ff3d68;
            --accent-b: #7b2ff7;
            --accent-c: #2de0c6;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            height: 100%;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', -apple-system, sans-serif;
        }

        .layout {
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            min-height: 100vh;
        }

        /* ---------- Left: identity panel ---------- */
        .stage {
            position: relative;
            overflow: hidden;
            background: linear-gradient(200deg, rgba(10,10,15,.35) 0%, rgba(10,10,15,.85) 55%, #0a0a0f 100%), url('/Bepop/assets/img/b6.jpg') center / cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3rem;
        }

        .brand-row {
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .brand-mark {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: conic-gradient(from 90deg, var(--accent-a), var(--accent-b), var(--accent-c), var(--accent-a));
            position: relative;
            flex: none;
        }

            .brand-mark::after {
                content: '';
                position: absolute;
                inset: 34%;
                background: var(--bg);
                border-radius: 50%;
            }

        .brand-name {
            font-family: 'Unbounded', sans-serif;
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: .02em;
        }

        .stage-copy {
            max-width: 420px;
            margin-top: auto;
            margin-bottom: 3.5rem;
        }

        .stage-eyebrow {
            font-size: .72rem;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--accent-c);
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .stage-headline {
            font-family: 'Unbounded', sans-serif;
            font-weight: 800;
            font-size: clamp(2.2rem, 4vw, 3.2rem);
            line-height: 1.05;
            margin: 0 0 1rem;
        }

            .stage-headline span {
                background: linear-gradient(95deg, var(--accent-a), var(--accent-b));
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

        .stage-sub {
            color: var(--muted);
            font-size: .95rem;
            line-height: 1.6;
        }

        /* equalizer signature */
        .eq {
            display: flex;
            align-items: flex-end;
            gap: 5px;
            height: 46px;
        }

            .eq span {
                width: 4px;
                border-radius: 3px;
                background: linear-gradient(180deg, var(--accent-c), var(--accent-b));
                animation: bounce 1.2s ease-in-out infinite;
                opacity: .85;
            }

                .eq span:nth-child(1) {
                    height: 30%;
                    animation-delay: -1.0s;
                }

                .eq span:nth-child(2) {
                    height: 65%;
                    animation-delay: -0.8s;
                }

                .eq span:nth-child(3) {
                    height: 45%;
                    animation-delay: -1.3s;
                }

                .eq span:nth-child(4) {
                    height: 90%;
                    animation-delay: -0.5s;
                }

                .eq span:nth-child(5) {
                    height: 55%;
                    animation-delay: -0.2s;
                }

                .eq span:nth-child(6) {
                    height: 75%;
                    animation-delay: -1.1s;
                }

                .eq span:nth-child(7) {
                    height: 35%;
                    animation-delay: -0.6s;
                }

                .eq span:nth-child(8) {
                    height: 60%;
                    animation-delay: -0.9s;
                }

                .eq span:nth-child(9) {
                    height: 40%;
                    animation-delay: -0.3s;
                }

                .eq span:nth-child(10) {
                    height: 80%;
                    animation-delay: -1.4s;
                }

                .eq span:nth-child(11) {
                    height: 50%;
                    animation-delay: -0.7s;
                }

                .eq span:nth-child(12) {
                    height: 25%;
                    animation-delay: -0.4s;
                }

        @@keyframes bounce {
            0%, 100%

        {
            transform: scaleY(.35);
        }

        50% {
            transform: scaleY(1);
        }

        }

        .stage-foot {
            display: flex;
            gap: 1.4rem;
            font-size: .82rem;
            color: var(--muted);
        }

            .stage-foot a {
                color: var(--muted);
                text-decoration: none;
            }

                .stage-foot a:hover {
                    color: var(--text);
                }

        /* ---------- Right: form panel ---------- */
        .panel {
            background: var(--panel);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 2rem;
        }

        .form-wrap {
            width: 100%;
            max-width: 380px;
        }

            .form-wrap h1 {
                font-family: 'Unbounded', sans-serif;
                font-size: 1.5rem;
                font-weight: 700;
                margin: 0 0 .3rem;
            }

            .form-wrap .lede {
                color: var(--muted);
                font-size: .88rem;
                margin: 0 0 1.8rem;
            }

        .field {
            position: relative;
            margin-bottom: 1.05rem;
        }

            .field input {
                width: 100%;
                background: var(--panel-2);
                border: 1px solid var(--line);
                border-radius: 10px;
                padding: 1.15rem .9rem .45rem;
                font-size: .92rem;
                color: var(--text);
                font-family: 'Inter', sans-serif;
                outline: none;
                transition: border-color .18s ease, background .18s ease;
            }

                .field input::placeholder {
                    color: transparent;
                }

            .field label {
                position: absolute;
                left: .9rem;
                top: .95rem;
                font-size: .92rem;
                color: var(--muted);
                pointer-events: none;
                transition: all .15s ease;
            }

            .field input:focus,
            .field input:not(:placeholder-shown) {
                border-color: var(--accent-b);
            }

                .field input:focus + label,
                .field input:not(:placeholder-shown) + label {
                    top: .38rem;
                    font-size: .66rem;
                    letter-spacing: .03em;
                    color: var(--accent-c);
                }

        .row-between {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: -.3rem 0 1.3rem;
        }

        .check-label {
            display: flex;
            align-items: center;
            gap: .55rem;
            font-size: .84rem;
            color: var(--muted);
            cursor: pointer;
            user-select: none;
        }

            .check-label input {
                appearance: none;
                -webkit-appearance: none;
                width: 17px;
                height: 17px;
                border-radius: 5px;
                border: 1px solid var(--line);
                background: var(--panel-2);
                display: inline-block;
                position: relative;
                cursor: pointer;
                transition: border-color .15s ease, background .15s ease;
                flex: none;
            }

                .check-label input:checked {
                    background: linear-gradient(95deg, var(--accent-c), var(--accent-a));
                    border-color: transparent;
                }

                    .check-label input:checked::after {
                        content: '';
                        position: absolute;
                        left: 5px;
                        top: 1.5px;
                        width: 4px;
                        height: 9px;
                        border: solid #0a0a0f;
                        border-width: 0 2px 2px 0;
                        transform: rotate(45deg);
                    }

        .forgot-link {
            font-size: .82rem;
            color: var(--muted);
            text-decoration: none;
        }

            .forgot-link:hover {
                color: var(--accent-c);
            }

        .btn-submit {
            width: 100%;
            border: none;
            border-radius: 10px;
            padding: .95rem 1rem;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: .92rem;
            color: #0a0a0f;
            background: linear-gradient(95deg, var(--accent-c), var(--accent-a) 130%);
            cursor: pointer;
            transition: filter .18s ease, transform .18s ease;
        }

            .btn-submit:hover {
                filter: brightness(1.08);
                transform: translateY(-1px);
            }

        .signup-note {
            text-align: center;
            font-size: .85rem;
            color: var(--muted);
            margin-top: 1.4rem;
        }

            .signup-note a {
                color: var(--text);
                font-weight: 600;
                text-decoration: none;
                border-bottom: 1px solid var(--accent-b);
            }

        .validation-summary-errors ul {
            list-style: none;
            padding: .8rem 1rem;
            margin: 0 0 1.1rem;
            background: rgba(255, 61, 104, .1);
            border: 1px solid rgba(255, 61, 104, .35);
            border-radius: 10px;
            color: #ff8ba3;
            font-size: .82rem;
        }

        @@media (max-width: 860px) {
            .layout

        {
            grid-template-columns: 1fr;
        }

        .stage {
            display: none;
        }

        }
    </style>
</head>
<body>
    <div class="layout">
        <div class="stage">
            <div class="brand-row">
                <div class="brand-mark"></div>
                <div class="brand-name">Bepop</div>
            </div>

            <div class="stage-copy">
                <div class="stage-eyebrow">Music Web Application</div>
                <h1 class="stage-headline">Pick up right where the <span>beat</span> left off.</h1>
                <p class="stage-sub">Your playlists, your library, your people &mdash; all waiting on the other side of one login.</p>
            </div>

            <div class="eq" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span><span></span>
            </div>

            <div class="stage-foot" style="margin-top:1.4rem;">
                <a href="index.html">About</a>
                <a href="#">Terms</a>
                <a href="#">Policy</a>
            </div>
        </div>

        <div class="panel">
            <div class="form-wrap">
                <h1>Welcome back</h1>
                <p class="lede">Log in to manage your account</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly"></div>

                    <div class="field">
                        <input type="text" asp-for="Username" placeholder=" ">
                        <label>Username</label>
                    </div>

                    <div class="field">
                        <input type="password" asp-for="Password" placeholder=" ">
                        <label>Password</label>
                    </div>

                    <div class="row-between">
                        <label class="check-label">
                            <input type="checkbox" />
                            Remember me
                        </label>
                        <a href="forgot-password.html" class="forgot-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-submit">Sign in</button>

                    <p class="signup-note">Don't have an account? <a href="/Auth/Register/">Sign up</a></p>
                </form>
            </div>
        </div>
    </div>
</body>
</html>

@model List<ResultGenreDto>
@{
    ViewData["Title"] = "GenreList";
    Layout = "~/Views/Shared/_MainLayout.cshtml";

    int i = 0;
    var accents = new[] { "#ffb627", "#7b2ff7", "#5fd0c0", "#ff6b57", "#5b8cff", "#ff5fa2" };
}

<style>
    .genre-page {
        --amber: #ffb627;
        --violet: #7b2ff7;
        --ink: #f5f3ee;
        --ink-dim: #9793a3;
        --line: #ffffff14;
        --radius: 18px;
        color: var(--ink);
        font-family: 'Inter', sans-serif;
        -webkit-font-smoothing: antialiased;
    }

        .genre-page a {
            color: inherit;
            text-decoration: none;
        }

    @@media (prefers-reduced-motion: reduce) {
        .genre-page * {
            animation-duration: .001ms !important;
            transition-duration: .001ms !important;
        }
    }

    .genre-page .hero {
        padding: clamp(48px,9vw,96px) clamp(20px,5vw,56px) clamp(30px,6vw,60px);
        max-width: 1180px;
        margin: 0 auto;
        position: relative;
    }

        .genre-page .hero::before {
            content: "";
            position: absolute;
            top: 0;
            right: clamp(20px,5vw,56px);
            width: 220px;
            height: 220px;
            background: radial-gradient(circle, var(--amber) 0%, transparent 70%);
            opacity: .12;
            pointer-events: none;
            z-index: -1;
        }

    .genre-page .eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: .72rem;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: var(--amber);
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

        .genre-page .eyebrow::before {
            content: "";
            width: 26px;
            height: 1px;
            background: var(--amber);
        }

    .genre-page h1.display {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: clamp(2.4rem,6vw,4.2rem);
        line-height: 1.02;
        letter-spacing: -.02em;
        max-width: 14ch;
        margin: 0 0 20px;
        color: var(--ink);
    }

        .genre-page h1.display em {
            font-style: italic;
            font-weight: 300;
            color: var(--ink-dim);
        }

    .genre-page .hero p.sub {
        max-width: 46ch;
        color: var(--ink-dim);
        font-size: 1.05rem;
        line-height: 1.6;
        margin: 0;
    }

    .genre-page .filter-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 clamp(20px,5vw,56px) 30px;
        border-bottom: 1px solid var(--line);
        padding-bottom: 22px;
    }

        .genre-page .filter-row .count {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--ink-dim);
            font-size: .85rem;
            font-family: 'JetBrains Mono', monospace;
            letter-spacing: .02em;
        }

            .genre-page .filter-row .count .dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--amber);
                flex-shrink: 0;
            }

        .genre-page .filter-row .hint {
            color: var(--ink-dim);
            font-size: .8rem;
            opacity: .7;
        }

    .genre-page .grid {
        max-width: 1180px;
        margin: 0 auto;
        padding: 40px clamp(20px,5vw,56px) 100px;
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(240px,1fr));
        gap: 22px;
    }

    .genre-page .genre-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius);
        padding: 26px 22px 22px;
        min-height: 200px;
        background: #1a1a28;
        border: 1px solid var(--line);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        isolation: isolate;
        transition: transform .35s cubic-bezier(.2,.8,.2,1), border-color .35s;
    }

        .genre-page .genre-card:hover,
        .genre-page .genre-card:focus-visible {
            transform: translateY(-6px);
            border-color: var(--card-accent, var(--amber));
            outline: none;
        }

        .genre-page .genre-card:focus-visible {
            box-shadow: 0 0 0 2px var(--card-accent, var(--amber));
        }

        .genre-page .genre-card .wash {
            position: absolute;
            inset: 0;
            z-index: -2;
            background: radial-gradient(120% 90% at 100% -10%, var(--card-accent, var(--amber)) 0%, transparent 55%);
            opacity: .35;
        }

        .genre-page .genre-card .disc {
            position: absolute;
            top: -34px;
            right: -34px;
            width: 130px;
            height: 130px;
            border-radius: 50%;
            background: repeating-radial-gradient(circle at 50% 50%, #00000055 0 2px, transparent 2px 5px), conic-gradient(from 0deg, var(--card-accent, var(--amber)), #00000090, var(--card-accent, var(--amber)));
            transition: transform .6s ease;
            z-index: -1;
        }

            .genre-page .genre-card .disc::after {
                content: "";
                position: absolute;
                inset: 44%;
                background: #0b0b12;
                border-radius: 50%;
            }

        .genre-page .genre-card:hover .disc {
            transform: rotate(85deg);
        }

        .genre-page .genre-card .idx {
            font-family: 'JetBrains Mono', monospace;
            font-size: .68rem;
            letter-spacing: .14em;
            color: var(--card-accent, var(--amber));
            opacity: .8;
            margin-bottom: 12px;
        }

        .genre-page .genre-card h3 {
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-size: 1.5rem;
            margin: 0;
            letter-spacing: -.01em;
            color: var(--ink);
        }

        .genre-page .genre-card .explore {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 12px;
            font-size: .78rem;
            font-weight: 600;
            color: var(--card-accent, var(--amber));
            opacity: 0;
            transform: translateY(4px);
            transition: opacity .3s, transform .3s;
        }

            .genre-page .genre-card .explore svg {
                transition: transform .3s;
            }

        .genre-page .genre-card:hover .explore,
        .genre-page .genre-card:focus-visible .explore {
            opacity: 1;
            transform: none;
        }

            .genre-page .genre-card:hover .explore svg {
                transform: translateX(3px);
            }

    .genre-page .empty {
        max-width: 1180px;
        margin: 0 auto;
        padding: 20px clamp(20px,5vw,56px) 100px;
    }

        .genre-page .empty .empty-panel {
            border: 1px dashed var(--line);
            border-radius: var(--radius);
            padding: 56px 24px;
            text-align: center;
            color: var(--ink-dim);
        }

            .genre-page .empty .empty-panel h4 {
                font-family: 'Fraunces', serif;
                font-weight: 600;
                font-size: 1.3rem;
                color: var(--ink);
                margin: 0 0 8px;
            }
</style>

<div class="genre-page">
    <div class="page-content page-container" id="page-content">
        <div class="padding sr">
            <section class="hero">
                <div class="eyebrow">Kütüphane / Türler</div>
                <h1 class="display">Bir tür seç,<br><em>bir dünyaya gir.</em></h1>
                <p class="sub">Her tür kendi ritmini, kendi zeminini taşır. Aşağıdaki plaklardan birine dokun, o türe ait parçaların tamamı önünde açılsın.</p>
            </section>

            <div class="filter-row">
                <span class="count"><span class="dot"></span>@Model.Count tür</span>
                <span class="hint">Bir kapağa dokun ve keşfetmeye başla</span>
            </div>

            @if (Model.Count == 0)
            {
                <div class="empty">
                    <div class="empty-panel">
                        <h4>Henüz tür eklenmedi</h4>
                        <p style="margin:0;">Kütüphaneye tür eklendiğinde burada listelenecek.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="grid">
                    @foreach (var item in Model)
                    {
                        var accent = accents[i % accents.Length];
                        var idx = (i + 1).ToString("00");
                        i++;
                        <a class="genre-card" href="/Song/SongListByGenre/@item.GenreId"
                           style="--card-accent:@accent">
                            <span class="wash"></span>
                            <span class="disc"></span>
                            <span class="idx">No. @idx</span>
                            <h3>@item.GenreName</h3>
                            <span class="explore">
                                Keşfet
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                            </span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@model List<ResultPackageDto>
@{
    ViewData["Title"] = "PackageList";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #0a0a0f;
        --panel: #121218;
        --panel-2: #17171f;
        --line: #24242e;
        --text: #f5f5f7;
        --muted: #86869a;
        --accent-a: #ff3d68;
        --accent-b: #7b2ff7;
        --accent-c: #2de0c6;
    }

    #page-content {
        padding-top: 72px;
    }

    .upgrade-hero {
        position: relative;
        width: 100%;
        padding: 2.6rem 2rem 1.8rem;
        text-align: center;
        overflow: hidden;
        background: radial-gradient(60% 100% at 50% 0%, rgba(123, 47, 247, .25), transparent 70%), var(--panel);
        border-bottom: 1px solid var(--line);
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--text);
    }

        .upgrade-hero h1 {
            font-family: 'Unbounded', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            margin: 0 0 .4rem;
        }

        .upgrade-hero p {
            margin: 0;
            color: var(--muted);
            font-size: .86rem;
        }

    .upgrade-container {
        max-width: 980px;
        margin: 0 auto;
        padding: 2.2rem 2rem 3.4rem;
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--text);
    }

    .pkg-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.6rem;
    }

    /* Seçim mekanizması: gizli radio + label kart olarak stillenir (JS yok) */
    .pkg-radio {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
        pointer-events: none;
    }

    .pkg-card {
        position: relative;
        display: block;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.4rem 1.2rem;
        cursor: pointer;
        transition: border-color .18s ease, transform .18s ease, background .18s ease;
    }

        .pkg-card:hover {
            border-color: var(--accent-b);
            transform: translateY(-2px);
        }

    .pkg-radio:checked + .pkg-card {
        border-color: var(--accent-c);
        background: rgba(45, 224, 198, .06);
    }

    .pkg-radio:focus-visible + .pkg-card {
        outline: 2px solid var(--accent-c);
        outline-offset: 2px;
    }

    .pkg-card.current {
        opacity: .6;
        cursor: default;
    }

        .pkg-card.current:hover {
            border-color: var(--line);
            transform: none;
        }

    .pkg-level-tag {
        display: inline-block;
        font-size: .65rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--accent-c);
        margin-bottom: .6rem;
    }

    .pkg-name {
        font-family: 'Unbounded', sans-serif;
        font-weight: 700;
        font-size: 1.05rem;
        margin: 0 0 .3rem;
        color: var(--text);
    }

    .pkg-price {
        font-family: 'Unbounded', sans-serif;
        font-weight: 800;
        font-size: 1.3rem;
        color: var(--text);
        margin: 0;
    }

        .pkg-price span {
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            font-size: .72rem;
            color: var(--muted);
        }

    .current-chip {
        position: absolute;
        top: 1rem;
        right: 1rem;
        font-size: .62rem;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--muted);
        background: var(--panel-2);
        border: 1px solid var(--line);
        padding: .25rem .55rem;
        border-radius: 999px;
    }

    .selected-check {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--accent-c);
        display: none;
        align-items: center;
        justify-content: center;
    }

        .selected-check svg {
            width: 12px;
            height: 12px;
            color: #0a0a0f;
        }

    .pkg-radio:checked + .pkg-card .selected-check {
        display: flex;
    }

    .confirm-bar {
        position: sticky;
        bottom: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.1rem 1.4rem;
    }

    .confirm-text {
        font-size: .84rem;
        color: var(--muted);
    }

    .confirm-actions {
        display: flex;
        gap: .7rem;
    }

    .btn-primary {
        border: none;
        border-radius: 10px;
        padding: .8rem 1.4rem;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .86rem;
        color: #0a0a0f;
        background: linear-gradient(95deg, var(--accent-c), var(--accent-a) 130%);
        cursor: pointer;
        transition: filter .18s ease, transform .18s ease;
    }

        .btn-primary:hover {
            filter: brightness(1.08);
            transform: translateY(-1px);
        }

    .btn-ghost {
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: .8rem 1.2rem;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .86rem;
        color: var(--muted);
        background: transparent;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: border-color .18s ease, color .18s ease;
    }

        .btn-ghost:hover {
            border-color: var(--accent-b);
            color: var(--text);
        }

    @@media (max-width: 860px) {
        .pkg-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 480px) {
        .pkg-grid {
            grid-template-columns: 1fr;
        }

        .confirm-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .confirm-actions {
            justify-content: stretch;
        }

            .confirm-actions .btn-primary,
            .confirm-actions .btn-ghost {
                flex: 1;
                text-align: center;
                justify-content: center;
            }
    }
</style>

<div class="page-content" id="page-content">

    <section class="upgrade-hero">
        <h1>Paketini seç</h1>
        <p>Yükseltmek istediğin paketi seç, aşağıdan onayla.</p>
    </section>

    <main class="upgrade-container page-container">
        <form method="post" asp-action="ChangePackage">
            <div class="pkg-grid">
                @foreach (var item in Model)
                {
                    var isCurrent = item.PackageId == ViewBag.CurrentPackageId;
                    var radioId = "pkg-" + item.PackageId;

                    if (isCurrent)
                    {
                        <div class="pkg-card current">
                            <div class="current-chip">Mevcut plan</div>
                            <div class="pkg-level-tag">Seviye @item.PackageLevel</div>
                            <div class="pkg-name">@item.PackageName</div>
                            @if (item.Price == 0)
                            {
                                <div class="pkg-price">Ücretsiz</div>
                            }
                            else
                            {
                                <div class="pkg-price">@item.Price.ToString("0.00") ₺<span> /ay</span></div>
                            }
                        </div>
                    }
                    else
                    {
                        <input type="radio" class="pkg-radio" id="@radioId" name="packageId" value="@item.PackageId" required>
                        <label for="@radioId" class="pkg-card">
                            <div class="selected-check">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </div>
                            <div class="pkg-level-tag">Seviye @item.PackageLevel</div>
                            <div class="pkg-name">@item.PackageName</div>
                            @if (item.Price == 0)
                            {
                                <div class="pkg-price">Ücretsiz</div>
                            }
                            else
                            {
                                <div class="pkg-price">@item.Price.ToString("0.00") ₺<span> /ay</span></div>
                            }
                        </label>
                    }
                }
            </div>

            <div class="confirm-bar">
                <div class="confirm-text">Bir paket seçip devam edebilirsin.</div>
                <div class="confirm-actions">
                    <a href="javascript:history.back()" class="btn-ghost">Vazgeç</a>
                    <button type="submit" class="btn-primary">Paketi onayla</button>
                </div>
            </div>
        </form>
    </main>
</div>

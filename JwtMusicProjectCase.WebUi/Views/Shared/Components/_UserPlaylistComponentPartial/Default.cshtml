@model List<ResultPlaylistDto>

<style>
    .pl-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 22px;
    }

    .pl-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        border-radius: 16px;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.07);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .pl-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255,255,255,0.18);
            box-shadow: 0 16px 32px rgba(0,0,0,0.35);
        }

    /* Kapak alanı: koyu zemin üstünde dönen vinil plak */
    .pl-art {
        position: relative;
        aspect-ratio: 1 / 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--c1) 35%, transparent), transparent 60%), radial-gradient(circle at 70% 80%, color-mix(in srgb, var(--c2) 35%, transparent), transparent 60%), #14141c;
        overflow: hidden;
    }

    .pl-disc {
        position: relative;
        width: 62%;
        aspect-ratio: 1;
        border-radius: 50%;
        background: repeating-radial-gradient( circle, #1c1c26 0px, #1c1c26 3px, #26262f 4px, #1c1c26 5px );
        box-shadow: 0 8px 20px rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform .6s ease;
    }

    .pl-card:hover .pl-disc {
        transform: rotate(50deg);
    }

    .pl-disc-ring {
        position: absolute;
        inset: 30%;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--c1), var(--c2));
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.15);
    }

    .pl-disc-hole {
        position: absolute;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #0b0b10;
        box-shadow: 0 0 0 2px rgba(255,255,255,0.1);
    }

    .pl-play {
        position: absolute;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: rgba(255,255,255,0.95);
        color: #14141c;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transform: scale(0.8);
        transition: opacity .2s ease, transform .2s ease;
        box-shadow: 0 6px 16px rgba(0,0,0,0.4);
    }

        .pl-play svg {
            width: 18px;
            height: 18px;
            margin-left: 2px;
        }

    .pl-card:hover .pl-play {
        opacity: 1;
        transform: scale(1);
    }

    .pl-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0,0,0,0.55);
        backdrop-filter: blur(4px);
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.15);
    }

    .pl-body {
        padding: 14px 14px 16px;
    }

    .pl-name {
        font-weight: 600;
        font-size: 14.5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 6px;
    }

    .pl-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        color: rgba(255,255,255,0.5);
    }

    .pl-link {
        color: #a78bfa;
        font-weight: 600;
        opacity: 0;
        transform: translateX(-4px);
        transition: opacity .2s ease, transform .2s ease;
    }

    .pl-card:hover .pl-link {
        opacity: 1;
        transform: translateX(0);
    }

    /* Yeni playlist ekleme kartı — pl-card ile birebir aynı iskelet (art + body) */
    .pl-add-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        border-radius: 16px;
        background: rgba(255,255,255,0.02);
        border: 2px dashed rgba(255,255,255,0.15);
        overflow: hidden;
        cursor: pointer;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease, background .2s ease, color .2s ease;
        color: rgba(255,255,255,0.55);
    }

        .pl-add-card:hover {
            transform: translateY(-5px);
            border-color: #a78bfa;
            color: #a78bfa;
            background: rgba(167,139,250,0.06);
            box-shadow: 0 16px 32px rgba(0,0,0,0.35);
        }

    .pl-add-art {
        position: relative;
        aspect-ratio: 1 / 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.015);
    }

    .pl-add-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid currentColor;
        transition: transform .25s ease;
    }

        .pl-add-icon svg {
            width: 20px;
            height: 20px;
        }

    .pl-add-card:hover .pl-add-icon {
        transform: scale(1.08) rotate(90deg);
    }

    .pl-add-body {
        padding: 14px 14px 16px;
        text-align: center;
    }

    .pl-add-text {
        font-weight: 600;
        font-size: 14.5px;
    }

    /* Modal */
    .pl-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(3px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

        .pl-modal-overlay.active {
            display: flex;
        }

    .pl-modal {
        width: 100%;
        max-width: 380px;
        background: #17171f;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }

        .pl-modal h3 {
            margin: 0 0 16px;
            font-size: 16px;
            font-weight: 600;
            color: #fff;
        }

        .pl-modal label {
            display: block;
            font-size: 12px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 6px;
        }

        .pl-modal input[type="text"] {
            width: 100%;
            box-sizing: border-box;
            padding: 10px 12px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.12);
            background: rgba(255,255,255,0.03);
            color: #fff;
            font-size: 14px;
            outline: none;
            transition: border-color .2s ease;
        }

            .pl-modal input[type="text"]:focus {
                border-color: #a78bfa;
            }

    .pl-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 18px;
    }

    .pl-btn {
        border: none;
        border-radius: 10px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: opacity .2s ease;
    }

        .pl-btn:hover {
            opacity: 0.85;
        }

    .pl-btn-cancel {
        background: rgba(255,255,255,0.06);
        color: rgba(255,255,255,0.7);
    }

    .pl-btn-save {
        background: linear-gradient(135deg, #7c3aed, #a21caf);
        color: #fff;
    }
</style>
<div class="tab-panel" id="panel-playlists">
    <div class="card">
        <div class="card-head">
            <div class="card-head-title">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
                <h2>Playlists</h2>
            </div>
            <span>@Model.Count playlists</span>
        </div>
        <div class="pl-grid">

            <div class="pl-add-card" onclick="plOpenAddModal()">
                <div class="pl-add-art">
                    <div class="pl-add-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </div>
                </div>
                <div class="pl-add-body">
                    <div class="pl-add-text">Yeni Playlist</div>
                </div>
            </div>

            @{
                string[][] palettes = {
                        new[] { "#4338ca", "#7c3aed" },
                        new[] { "#be123c", "#ea580c" },
                        new[] { "#0e7490", "#0284c7" },
                        new[] { "#166534", "#65a30d" },
                        new[] { "#a21caf", "#db2777" }
                        };
                int i = 0;
            }
            @foreach (var item in Model)
            {
                var c = palettes[i % palettes.Length];
                i++;

                <a href="/Playlist/PlaylistDetail/@item.PlaylistId" class="pl-card">
                    <div class="pl-art" style="--c1:@c[0]; --c2:@c[1]">
                        <div class="pl-disc">
                            <div class="pl-disc-ring"></div>
                            <div class="pl-disc-hole"></div>
                        </div>
                        <div class="pl-play">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
                        </div>
                    </div>
                    <div class="pl-body">
                        <div class="pl-name">@item.PlaylistName</div>
                        <div class="pl-meta">
                            <span class="pl-link">Detayları Gör →</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</div>

<!-- Yeni Playlist Modalı -->
<div class="pl-modal-overlay" id="plAddModalOverlay">
    <div class="pl-modal">
        <h3>Yeni Playlist Oluştur</h3>
        <form id="plAddForm" method="post" asp-action="CreatePlaylist" asp-controller="Playlist">
            <label for="plNameInput">Playlist Adı</label>
            <input type="text" id="plNameInput" name="PlaylistName" placeholder="Örn: Yol Müzikleri" required maxlength="100" autocomplete="off" />
            <div class="pl-modal-actions">
                <button type="button" class="pl-btn pl-btn-cancel" onclick="plCloseAddModal()">Vazgeç</button>
                <button type="submit" class="pl-btn pl-btn-save">Oluştur</button>
            </div>
        </form>
    </div>
</div>

<script>
    function plOpenAddModal() {
        document.getElementById('plAddModalOverlay').classList.add('active');
        document.getElementById('plNameInput').focus();
    }

    function plCloseAddModal() {
        document.getElementById('plAddModalOverlay').classList.remove('active');
        document.getElementById('plAddForm').reset();
    }

    // Overlay'e (dışına) tıklanınca kapat
    document.getElementById('plAddModalOverlay').addEventListener('click', function (e) {
        if (e.target === this) plCloseAddModal();
    });

    // ESC ile kapat
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') plCloseAddModal();
    });
</script>
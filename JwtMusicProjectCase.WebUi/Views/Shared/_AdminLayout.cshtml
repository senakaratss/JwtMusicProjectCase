@* ============================================================
   Views/Shared/_AdminLayout.cshtml
   Common shell for the entire Admin Panel: sidebar + topbar + content.
   Set ViewBag.Title and ViewBag.ActiveNav ("Dashboard","Songs","Users",
   "Artists","Genres","Packages") from each view, e.g.:
     @{ ViewBag.Title = "Songs"; ViewBag.ActiveNav = "Songs"; }
   Does not touch any existing API/controller/auth logic — presentation only.
   ============================================================ *@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - JWT Music Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="admin-shell">
        <div class="sidebar-backdrop" data-sidebar-toggle></div>

        @* ============================================================
   Views/Shared/_AdminSidebar.cshtml
   Reusable sidebar. Reads ViewBag.ActiveNav to highlight the
   current section. No backend / controller logic here — hrefs use
   asp-controller/asp-action, adjust the controller names below to
   match your existing MVC controllers if they differ.
   ============================================================ *@
        @{
            string active = ViewBag.ActiveNav as string ?? "Dashboard";
            Func<string, string> navClass = (name) => name == active ? "nav-item active" : "nav-item";
        }
        <aside class="admin-sidebar">
            <div class="sidebar-brand">
                <div class="brand-mark"><span></span><span></span><span></span><span></span></div>
                <div class="brand-name">
                    JWT Music
                    <small>Admin Panel</small>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-label">Genel</div>
                <a class="@navClass("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
                    <span class="label">Dashboard</span>
                </a>

                <div class="nav-label">Katalog</div>
                <a class="@navClass("Songs")" asp-area="Admin" asp-controller="Song" asp-action="SongList">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
                    <span class="label">Songs</span>
                </a>
                <a class="@navClass("Artists")" asp-area="Admin" asp-controller="Artist" asp-action="ArtistList">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2" /><path d="M5 21c0-3.9 3.1-7 7-7s7 3.1 7 7" /></svg>
                    <span class="label">Artists</span>
                </a>
                <a class="@navClass("Genres")" asp-area="Admin" asp-controller="Genre" asp-action="GenreList">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h10M4 18h6" /></svg>
                    <span class="label">Genres</span>
                </a>
                <a class="@navClass("Packages")" asp-area="Admin" asp-controller="Package" asp-action="PackageList">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5Z" /><path d="M3 8v8l9 5 9-5V8" /><path d="M12 13v8" /></svg>
                    <span class="label">Packages</span>
                </a>

                <div class="nav-label">Topluluk</div>
                <a class="@navClass("Users")" asp-area="Admin" asp-controller="User" asp-action="UserList">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    <span class="label">Users</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="storage-meter">
                    <span>Depolama</span>
                    <span class="text-mono">126 / 200 GB</span>
                </div>
                <div class="meter-track"><div class="meter-fill"></div></div>
            </div>
        </aside>


        <div class="admin-main">
            @* ============================================================
   Views/Shared/_AdminNavbar.cshtml
   Sticky topbar: sidebar toggle, page title, search, notifications,
   admin profile menu. ViewBag.Title / ViewBag.Breadcrumb are optional.
   ============================================================ *@
            <header class="admin-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" data-sidebar-toggle aria-label="Menüyü aç/kapat">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
                    </button>
                    <div>
                        <div class="page-heading">@(ViewBag.Title ?? "Dashboard")</div>
                        <div class="page-breadcrumb">@(ViewBag.Breadcrumb ?? "Admin Panel")</div>
                    </div>
                </div>

                <div class="topbar-search">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                    <input type="text" placeholder="Şarkı, sanatçı veya kullanıcı ara..." />
                </div>

                <div class="topbar-right">
                    <button class="icon-btn" aria-label="Bildirimler">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /></svg>
                        <span class="dot"></span>
                    </button>
                    <div class="admin-profile" data-dropdown-toggle="profileMenu" style="position:relative;">
                        <div class="avatar">AD</div>
                        <div class="who">
                            <div class="name">Admin User</div>
                            <div class="role">Super Admin</div>
                        </div>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6" /></svg>
                    </div>
                </div>
            </header>


            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

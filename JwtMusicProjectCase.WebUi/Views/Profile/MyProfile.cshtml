@model UserProfileDto
@using System.Security.Claims

@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["Title"] = "Profili Düzenle";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #0a0a0f;
        --panel: #121218;
        --panel-2: #17171f;
        --line: #24242e;
        --text: #f5f5f7;
        --muted: #86869a;
        --accent-a: #ff3d68;
        --accent-b: #7b2ff7;
        --accent-c: #2de0c6;
    }

    /* ---------- Profile hero ---------- */
    .profile-hero {
        position: relative;
        padding: 2.8rem 2rem 2rem;
        text-align: center;
        overflow: hidden;
        background: radial-gradient(60% 100% at 50% 0%, rgba(123, 47, 247, .25), transparent 70%), var(--panel);
        border-bottom: 1px solid var(--line);
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--text);
    }

    .avatar-lg {
        width: 92px;
        height: 92px;
        margin: 0 auto .9rem;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent-b), var(--accent-a));
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Unbounded', sans-serif;
        font-weight: 700;
        font-size: 1.7rem;
        color: #0a0a0f;
        position: relative;
        border: 4px solid var(--bg);
    }

    .avatar-edit {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--panel-2);
        border: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: border-color .18s ease;
    }

        .avatar-edit:hover {
            border-color: var(--accent-c);
        }

        .avatar-edit svg {
            width: 12px;
            height: 12px;
            color: var(--accent-c);
        }

    .profile-name {
        font-family: 'Unbounded', sans-serif;
        font-weight: 800;
        font-size: 1.4rem;
        margin: 0 0 .25rem;
        color: var(--text);
    }

    .profile-handle {
        color: var(--muted);
        font-size: .86rem;
        margin: 0;
    }

    .hero-plan-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        margin-top: .8rem;
        padding: .32rem .75rem;
        border-radius: 999px;
        background: rgba(45, 224, 198, .1);
        border: 1px solid rgba(45, 224, 198, .3);
        color: var(--accent-c);
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .02em;
    }

        .hero-plan-chip svg {
            width: 11px;
            height: 11px;
        }

    /* ---------- Tabs (sayfaya özel alt sekme, ana navbar DEĞİL) ---------- */
    .tab-bar {
        background: var(--panel);
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        z-index: 5;
    }

    .tab-bar-inner {
        max-width: 760px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        gap: 2.2rem;
        padding: 0 1rem;
    }

    .tab-bar a {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .9rem 0;
        text-decoration: none;
        color: var(--muted);
        font-size: .84rem;
        font-weight: 500;
        border-bottom: 2px solid transparent;
        transition: color .15s ease, border-color .15s ease;
    }

        .tab-bar a svg {
            width: 14px;
            height: 14px;
        }

        .tab-bar a:hover {
            color: var(--text);
        }

        .tab-bar a.active {
            color: var(--text);
            border-color: var(--accent-c);
        }

    /* ---------- Content ---------- */
    .page-container {
        max-width: 680px;
        margin: 0 auto;
        padding: 2rem 2rem 3.4rem;
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--text);
    }

    .tab-panel {
        display: none;
    }

        .tab-panel.active {
            display: block;
        }

    .panel-intro {
        margin: 0 0 1.1rem;
        font-size: .82rem;
        color: var(--muted);
    }

    /* ---------- Card ---------- */
    .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.5rem 1.6rem;
        margin-bottom: 1.1rem;
    }

        .card:last-child {
            margin-bottom: 0;
        }

    .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.2rem;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .card-head-title {
        display: flex;
        align-items: center;
        gap: .55rem;
    }

        .card-head-title svg {
            width: 16px;
            height: 16px;
            color: var(--accent-c);
            flex: none;
        }

    .card-head h2 {
        font-family: 'Unbounded', sans-serif;
        font-size: .92rem;
        font-weight: 600;
        margin: 0;
        color: var(--text);
    }

    .card-head span {
        font-size: .76rem;
        color: var(--muted);
    }

    .view-all {
        font-size: .76rem;
        color: var(--accent-c);
        text-decoration: none;
        font-weight: 500;
        flex: none;
    }

        .view-all:hover {
            text-decoration: underline;
        }

    .row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .8rem;
    }

    .field {
        position: relative;
        margin-bottom: .9rem;
    }

        .field:last-child {
            margin-bottom: 0;
        }

        .field input {
            width: 100%;
            background: var(--panel-2);
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 1.1rem .9rem .4rem;
            font-size: .9rem;
            color: var(--text);
            font-family: 'Inter', sans-serif;
            outline: none;
            transition: border-color .18s ease;
        }

            .field input::placeholder {
                color: transparent;
            }

        .field label {
            position: absolute;
            left: .9rem;
            top: .9rem;
            font-size: .9rem;
            color: var(--muted);
            pointer-events: none;
            transition: all .15s ease;
        }

        .field input:focus,
        .field input:not(:placeholder-shown) {
            border-color: var(--accent-b);
        }

            .field input:focus + label,
            .field input:not(:placeholder-shown) + label {
                top: .35rem;
                font-size: .64rem;
                letter-spacing: .03em;
                color: var(--accent-c);
            }

    .actions {
        display: flex;
        align-items: center;
        gap: .7rem;
        margin-top: .3rem;
    }

    .btn-primary {
        border: none;
        border-radius: 10px;
        padding: .8rem 1.4rem;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .86rem;
        color: #0a0a0f;
        background: linear-gradient(95deg, var(--accent-c), var(--accent-a) 130%);
        cursor: pointer;
        transition: filter .18s ease, transform .18s ease;
    }

        .btn-primary:hover {
            filter: brightness(1.08);
            transform: translateY(-1px);
        }

    .btn-ghost {
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: .8rem 1.2rem;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .86rem;
        color: var(--muted);
        background: transparent;
        cursor: pointer;
        transition: border-color .18s ease, color .18s ease;
    }

        .btn-ghost:hover {
            border-color: var(--accent-b);
            color: var(--text);
        }

    .btn-sm {
        padding: .55rem 1rem;
        font-size: .78rem;
    }

    .danger-card {
        border-color: rgba(255, 61, 104, .3);
        background: rgba(255, 61, 104, .04);
    }

        .danger-card .card-head-title svg {
            color: #ff8ba3;
        }

        .danger-card .card-head h2 {
            color: #ff8ba3;
        }

    .danger-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

        .danger-row p {
            margin: 0;
            font-size: .8rem;
            color: var(--muted);
            max-width: 380px;
        }

    .btn-danger {
        border: 1px solid rgba(255, 61, 104, .5);
        border-radius: 10px;
        padding: .65rem 1.1rem;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .8rem;
        color: #ff8ba3;
        background: transparent;
        cursor: pointer;
        flex: none;
        transition: background .18s ease;
    }

        .btn-danger:hover {
            background: rgba(255, 61, 104, .1);
        }

    .validation-summary-errors ul {
        list-style: none;
        padding: .8rem 1rem;
        margin: 0 0 1.1rem;
        background: rgba(255, 61, 104, .1);
        border: 1px solid rgba(255, 61, 104, .35);
        border-radius: 10px;
        color: #ff8ba3;
        font-size: .82rem;
    }

    /* ---------- Plan card ---------- */
    .plan-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .plan-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-family: 'Unbounded', sans-serif;
        font-weight: 700;
        font-size: .88rem;
        color: #0a0a0f;
        background: linear-gradient(95deg, var(--accent-c), var(--accent-a) 130%);
        padding: .4rem .85rem;
        border-radius: 999px;
    }

    .plan-meta {
        font-size: .8rem;
        color: var(--muted);
        margin-top: .35rem;
    }

    /* ---------- Playlists grid ---------- */
    .pl-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: .9rem;
    }

    .pl-item {
        text-decoration: none;
        color: inherit;
    }

    .pl-thumb {
        position: relative;
        width: 100%;
        padding-top: 100%;
        overflow: hidden;
        border-radius: 12px;
        background: var(--panel-2);
        border: 1px solid var(--line);
    }

        .pl-thumb img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .25s ease;
        }

        .pl-thumb::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 55%, rgba(0, 0, 0, .55));
            opacity: 0;
            transition: opacity .2s ease;
        }

    .pl-item:hover .pl-thumb img {
        transform: scale(1.06);
    }

    .pl-item:hover .pl-thumb::after {
        opacity: 1;
    }

    .pl-name {
        margin-top: .5rem;
        font-size: .8rem;
        font-weight: 500;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pl-count {
        font-size: .72rem;
        color: var(--muted);
    }

    /* ---------- Track rows (listening history) ---------- */
    .track-row {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: .65rem .5rem;
        margin: 0 -.5rem;
        border-radius: 10px;
        border-bottom: 1px solid var(--line);
        transition: background .15s ease;
    }

        .track-row:hover {
            background: var(--panel-2);
        }

        .track-row:last-child {
            border-bottom: none;
        }

    .track-thumb {
        position: relative;
        width: 46px;
        height: 46px;
        flex: none;
        border-radius: 10px;
        overflow: hidden;
        background: var(--panel-2);
        border: 1px solid var(--line);
    }

        .track-thumb img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .25s ease;
        }

    .track-row:hover .track-thumb img {
        transform: scale(1.08);
    }

    /* index number <-> play icon swap, à la music-app track lists */
    .track-index {
        position: relative;
        width: 20px;
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        font-variant-numeric: tabular-nums;
        color: var(--muted);
    }

        .track-index .idx-play {
            display: none;
            width: 12px;
            height: 12px;
            color: var(--accent-c);
        }

    .track-row:hover .track-index .idx-num {
        display: none;
    }

    .track-row:hover .track-index .idx-play {
        display: block;
    }

    .history-group {
        margin-bottom: 1.3rem;
    }

        .history-group:last-child {
            margin-bottom: 0;
        }

    .history-group-label {
        margin: 0 0 .5rem .1rem;
        font-size: .68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--muted);
    }

    .track-info {
        flex: 1;
        min-width: 0;
    }

    .track-title {
        font-size: .86rem;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .track-artist {
        font-size: .76rem;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .track-meta {
        font-size: .76rem;
        color: var(--muted);
        flex: none;
    }

    @@media (max-width: 720px) {
        .row-2 {
            grid-template-columns: 1fr;
        }

        .tab-bar-inner {
            gap: 1.2rem;
        }

        .pl-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<section class="profile-hero">
    <div class="avatar-lg">
        @{
            var initials = ((Model?.Name?.Substring(0, 1) ?? "") + (Model?.Surname?.Substring(0, 1) ?? "")).ToUpper();
        }
        <span>@(string.IsNullOrWhiteSpace(initials) ? "B" : initials)</span>
        <div class="avatar-edit" aria-label="Change avatar">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
            </svg>
        </div>
    </div>
    <h1 class="profile-name">@Model.Name @Model.Surname</h1>
    <p class="profile-handle">@Model.Username</p>
    <div class="hero-plan-chip">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 2.9 6.5L22 9.3l-5 4.6 1.3 6.9L12 17.8 5.7 20.8 7 13.9 2 9.3l7.1-.8Z"></path></svg>
        @Model.PackageName
    </div>
</section>

<nav class="tab-bar">
    <div class="tab-bar-inner">
        <a href="#" class="tab-bar-link active" data-target="panel-profile">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path></svg>
            Profile
        </a>
        <a href="#" class="tab-bar-link" data-target="panel-history">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path></svg>
            Listening history
        </a>
        <a href="#" class="tab-bar-link" data-target="panel-playlists">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
            Playlists
        </a>
    </div>
</nav>

<main class="page-container">

    @* ============================= PANEL: PROFILE (hesap yönetimi) ============================= *@
    <div class="tab-panel active" id="panel-profile">
        <p class="panel-intro">Kişisel bilgilerini, paketini ve hesap güvenliğini buradan yönet.</p>

        <form method="post" asp-controller="Profile" asp-action="UpdateProfile">
            @if (TempData["Error"] != null)
            {
                <div class="text-danger">
                    @TempData["Error"]
                </div>
            }

            <div class="card">
                <div class="card-head">
                    <div class="card-head-title">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path></svg>
                        <h2>Account details</h2>
                    </div>
                    <span>Shown on your profile</span>
                </div>
                <div class="row-2">
                    <div class="field">
                        <input type="text" asp-for="Name" placeholder=" " required>
                        <label>Name</label>
                    </div>
                    <div class="field">
                        <input type="text" asp-for="Surname" placeholder=" " required>
                        <label>Surname</label>
                    </div>
                </div>
                <div class="field">
                    <input type="text" asp-for="Username" placeholder=" " required>
                    <label>Username</label>
                </div>
                <div class="row-2">
                    <div class="field">
                        <input type="email" asp-for="Email" placeholder=" " required>
                        <label>Email</label>
                    </div>
                    <div class="field">
                        <input type="text" asp-for="PhoneNumber" placeholder=" " required>
                        <label>Phone number</label>
                    </div>
                </div>
                <div class="actions">
                    <button type="submit" class="btn-primary">Save changes</button>
                    <button type="button" class="btn-ghost">Cancel</button>
                </div>
            </div>

        </form>
        <div class="card">
            <div class="card-head">
                <div class="card-head-title">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 2 2.9 6.5L22 9.3l-5 4.6 1.3 6.9L12 17.8 5.7 20.8 7 13.9 2 9.3l7.1-.8Z"></path></svg>
                    <h2>Current plan</h2>
                </div>
            </div>
            <div class="plan-row">
                <div>
                    <span class="plan-badge">@Model.PackageName</span>
                    <div class="plan-meta">
                        Renews on 12 Sep 2026
                        <!-- TODO: @@Model.PlanRenewDate?.ToString("d MMM yyyy") -->
                    </div>
                </div>
                <div class="actions" style="margin-top:0;">
                    <a asp-controller="Package" asp-action="PackageList" asp-route-currentPackageId="@Model.PackageId"
                       class="btn-ghost btn-sm">Manage billing</a>
                    <a asp-controller="Package" asp-action="PackageList" asp-route-currentPackageId="@Model.PackageId"
                       class="btn-primary btn-sm">Upgrade</a>
                </div>
            </div>
        </div>
        <form method="post" asp-action="ChangePassword">
            @if (TempData["PasswordError"] != null)
            {
                <div class="text-danger">
                    @TempData["PasswordError"]
                </div>
            }
            <div class="card">
                <div class="card-head">
                    <div class="card-head-title">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <h2>Password</h2>
                    </div>
                    <span>Leave blank to keep current</span>
                </div>
                <div class="field">
                    <input type="password" name="CurrentPassword" placeholder=" ">
                    <label>Current password</label>
                </div>
                <div class="row-2">
                    <div class="field">
                        <input type="password" name="NewPassword" placeholder=" ">
                        <label>New password</label>
                    </div>
                    <div class="field">
                        <input type="password" name="ConfirmPassword" placeholder=" ">
                        <label>Confirm new password</label>
                    </div>
                </div>
                <div class="actions">
                    <button type="submit" class="btn-primary">Save changes</button>
                    <button type="button" class="btn-ghost">Cancel</button>
                </div>
            </div>
        </form>




        <div class="card danger-card" style="margin-top:1.1rem;">
            <div class="card-head">
                <div class="card-head-title">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
                    <h2>Delete account</h2>
                </div>
            </div>
            <div class="danger-row">
                <p>This permanently removes your profile, playlists, and listening history.</p>
                <button type="button" class="btn-danger">Delete account</button>
            </div>
        </div>
    </div>

    @await Component.InvokeAsync("_UserListeningHistoryComponentPartial")

    @await Component.InvokeAsync("_UserPlaylistComponentPartial")

</main>

<script>
    (function () {
        var links = document.querySelectorAll('.tab-bar-link');
        links.forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                links.forEach(function (l) { l.classList.remove('active'); });
                document.querySelectorAll('.tab-panel').forEach(function (p) { p.classList.remove('active'); });
                this.classList.add('active');
                document.getElementById(this.dataset.target).classList.add('active');
            });
        });
    })();
</script>
